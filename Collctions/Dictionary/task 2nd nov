# 2. Sum of All Elements
numbers = [
    [10, 20, 30, 40],
    [5, 15, 25, 35],
    [2, 4, 6, 8]
]

total = 0

for row in numbers:
    for num in row:
        total += num

print("Total Sum:", total)


# 3. Find the Largest Number (Without max())
numbers = [
    [12, 45, 23],
    [67, 34, 89],
    [10, 56, 78]
]

largest = numbers[0][0]

for row in numbers:
    for num in row:
        if num > largest:
            largest = num

print("Largest Number:", largest)


# 4. Count Even Numbers
numbers = [
    [12, 15, 18],
    [21, 24, 27],
    [30, 33, 36]
]

count = 0

for row in numbers:
    for num in row:
        if num % 2 == 0:
            count += 1

print("Total Even Numbers:", count)


# 5. Sum of Each Row
numbers = [
    [10, 20, 30],
    [5, 15, 25],
    [2, 4, 6]
]

for i in range(len(numbers)):
    total = 0

    for num in numbers[i]:
        total += num

    print("Row", i + 1, "Sum:", total)


# 6. Smallest Number in Each Row (Without min())
numbers = [
    [12, 5, 18, 9],
    [45, 23, 67, 10],
    [8, 14, 3, 20]
]

for i in range(len(numbers)):
    smallest = numbers[i][0]

    for num in numbers[i]:
        if num < smallest:
            smallest = num

    print("Row", i + 1, "Smallest:", smallest)


# 7. Sum of Diagonal Elements
