# 10. Total Marks of Each Student
students = {
    101: {"Maths": 80, "Physics": 75, "Chemistry": 90},
    102: {"Maths": 65, "Physics": 85, "Chemistry": 70},
    103: {"Maths": 90, "Physics": 95, "Chemistry": 85}
}

