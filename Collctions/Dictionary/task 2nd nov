    total = 0

    for subject in students[student_id]:
        total += students[student_id][subject]

    print("Student", student_id, "Total:", total)


# 11. Employee with Highest Salary (Without max())
employees = {
    101: {"salary": 25000},
    102: {"salary": 45000},
    103: {"salary": 35000},
    104: {"salary": 50000}
}

highest_salary = 0
employee_id = None

for emp_id in employees:
    salary = employees[emp_id]["salary"]

    if salary > highest_salary:
        highest_salary = salary
        employee_id = emp_id

print("Employee ID:", employee_id)
print("Highest Salary:", highest_salary)


# 12. Product Price After Discount
products = {
    101: {"price": 1000, "quantity": 2, "discount": 10},
    102: {"price": 500, "quantity": 3, "discount": 20},
    103: {"price": 2000, "quantity": 1, "discount": 15}
}

for product_id in products:
    price = products[product_id]["price"]
    quantity = products[product_id]["quantity"]
    discount = products[product_id]["discount"]

    total = price * quantity
    discount_amount = total * discount / 100
    final_price = total - discount_amount

    print("Product", product_id, "Final Price:", int(final_price))


# 13. Highest Scoring Subject
students = {
    101: {"Maths": 80, "Physics": 95, "Chemistry": 75},
    102: {"Maths": 90, "Physics": 85, "Chemistry": 95},
    103: {"Maths": 70, "Physics": 80, "Chemistry": 65}
}

for student_id in students:
    highest = -1
    highest_subject = ""

    for subject in students[student_id]:
        marks = students[student_id][subject]

        if marks > highest:
            highest = marks
            highest_subject = subject

    print("Student", student_id, "Highest Subject:", highest_subject)


